# Copy to .env and adjust. Do not put SIP or directory passwords here: enter them
# in the web interface, where they are stored protected in the config volume.
WEB_PORT=8080
# HTTPS port, used after you request a certificate in Administration › HTTPS (443 works too).
HTTPS_PORT=8443
TZ=Africa/Tripoli
# Set to true only when a separate reverse proxy terminates HTTPS. The built-in HTTPS sets Secure cookies itself.
AUTH_COOKIE_SECURE=false
# 3 = normal, 4 = include SIP message traces for troubleshooting (verbose)
SIP_LOG_LEVEL=3
APP_VERSION=local
