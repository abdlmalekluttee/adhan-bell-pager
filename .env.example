# Copy to .env and adjust. Do not put SIP or directory passwords here: enter them
# in the web interface, where they are stored protected in the config volume.
WEB_PORT=8080
TZ=Africa/Tripoli
# Set to true when the UI is served over HTTPS (reverse proxy), so cookies are Secure-only.
AUTH_COOKIE_SECURE=false
# 3 = normal, 4 = include SIP message traces for troubleshooting (verbose)
SIP_LOG_LEVEL=3
APP_VERSION=local
