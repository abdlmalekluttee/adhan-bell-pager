{
  "source": "DESIGN.md",
  "framework": "Tabler 1.5.1 (pinned)",
  "moduleScoping": "data-module on .page-wrapper and dialog.abp-dialog redefines --tblr-primary, --tblr-primary-rgb, --tblr-primary-darken, --tblr-primary-lt, --tblr-link-color",
  "shadows": {
    "dialog": "0 24px 60px -20px rgba(0,0,0,.45)",
    "toast": "0 12px 30px -14px rgba(0,0,0,.45)",
    "liveBar": "0 6px 18px -12px rgba(0,0,0,.35)",
    "saveBar": "0 -8px 24px -18px rgba(0,0,0,.4)"
  },
  "motion": {
    "ease": "cubic-bezier(.16, 1, .3, 1)",
    "dialogIn": "220ms",
    "toastIn": "250ms",
    "saveBar": "250ms",
    "progress": "transform 900ms linear",
    "reducedMotion": "animations disabled"
  },
  "focus": ":focus-visible 3px outline rgba(module, .55) offset 2px",
  "selection": "rgba(module, .22)"
}
